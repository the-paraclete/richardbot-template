#!/usr/bin/env bash
# richardbot-init — install / survey / seed / pack / verify / update / uninstall / copilot-mirror / rescan.
#
# Usage:
#   richardbot-init init           [target-dir] [--pack <name>] [--full] [--overview <path>] [--force]
#                                                                # lay down skeleton; --full also seeds + rescans + mirrors
#   richardbot-init survey         [target-dir]                   # detect stack + propose surface chunks
#   richardbot-init seed           [target-dir] [opts]            # auto-generate surface fragments via LLM
#   richardbot-init rescan         [target-dir] [opts]            # refresh .richardbot-memory/ bug findings (periodic)
#   richardbot-init plant          [target-dir] <name> [opts]     # write a single memory note (deliberate planting)
#   richardbot-init pack           <list|add|remove> [target-dir] [name]   # manage rule packs
#   richardbot-init mcp            <list|install|remove> [name...] [--keys-from <file>] [--yes] [target-dir]
#                                                                # manage MCP server stanzas in .mcp.json
#   richardbot-init copilot-mirror [target-dir]                   # generate .github/copilot-instructions.md + .github/instructions/
#   richardbot-init verify         [target-dir]                   # check framework integrity (hooks + settings)
#   richardbot-init update         [target-dir]                   # pull latest template; preserve project files
#   richardbot-init uninstall      [target-dir]                   # remove framework; preserve user-authored content
#   richardbot-init nuke           [target-dir]                   # remove EVERYTHING the template installs (destructive)
#   richardbot-init help
#
# `seed` options (after target-dir):
#   --surface <relpath>   only seed the surface at <relpath>; output to stdout
#   --model <name>        haiku | sonnet | opus (default: haiku)
#   --write               write generated fragments into target/.claude/rules/
#
# `rescan` options (after target-dir):
#   --surface <relpath>   rescan only that surface; default: enumerate (same heuristic as seed)
#   --model <name>        haiku | sonnet | opus (default: haiku)
#   --since <git-since>   restrict to surfaces touched by `git log --since=<spec>` (e.g. "7 days ago")
#   --age-out <days>      archive .richardbot-memory/*.md older than N days (default: off)
#   --no-mirror           skip the auto re-run of copilot-mirror after rescan
#
# `pack` modes:
#   pack list [target-dir]                # list installed packs (reads .claude/PACKS)
#   pack add <name> [target-dir]          # install rule fragments from packs/<name>/
#   pack remove <name> [target-dir]       # remove unmodified fragments from a previously-installed pack
#
# `mcp` modes:
#   mcp list [target-dir]                            # list installed MCPs (reads .claude/MCPS)
#   mcp install <name> [name...] [opts] [target-dir] # add MCP stanza(s) from .mcp.json.template, prompt for env vars
#   mcp remove  <name> [name...] [target-dir]        # remove MCP stanza(s) from .mcp.json (env vars preserved)
#
# `mcp install` options:
#   --keys-from <file>    pre-populate env-var values from a KEY=value file (skip prompts)
#   --yes                 non-interactive: leave any unset env var blank, don't prompt
#
# target-dir defaults to $(pwd).
#
# Install footprint (three places at the repo root):
#   1. CLAUDE.md                — spine; user fills in placeholders
#   2. .claude/                 — framework dir (hook, settings, rules, commands)
#   3. .richardbot-memory/       — agent-writable memory (outside .claude/ deliberately)

set -euo pipefail

# Resolve the template root (script lives at <root>/bin/richardbot-init)
TEMPLATE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 1
}

mode="${1:-help}"

# ── mcp ────────────────────────────────────────────────────────────────────
# Install / list / remove MCP server stanzas in .mcp.json from packs/mcp-<name>/.
# Args after "mcp" are <sub> [<name>...] [--keys-from <file>] [--yes] [target-dir];
# target defaults to pwd.
do_mcp() {
  shift  # drop "mcp" mode arg

  local sub="${1:-list}"
  shift || true

  local keys_from=""
  local non_interactive="0"
  local names=()
  local target_set="0"
  while [ $# -gt 0 ]; do
    case "$1" in
      --keys-from) keys_from="$2"; shift 2 ;;
      --yes)       non_interactive="1"; shift ;;
      --target)    target="$(cd "$2" && pwd)"; target_set="1"; shift 2 ;;
      --*)         echo "⚠ unknown mcp flag: $1" >&2; shift ;;
      *)
        if [ "$target_set" = "0" ] && { [ -d "$1/.claude" ] || [ -f "$1/CLAUDE.md" ]; }; then
          target="$(cd "$1" && pwd)"
          target_set="1"
        else
          names+=("$1")
        fi
        shift
        ;;
    esac
  done

  local template="$TEMPLATE_ROOT/.mcp.json.template"
  [ -f "$template" ] || { echo "⚠ No .mcp.json.template in $TEMPLATE_ROOT" >&2; exit 2; }

  case "$sub" in
    list)
      local manifest="$target/.claude/MCPS"
      if [ ! -f "$manifest" ]; then
        echo "No MCP packs installed (no $manifest)."
        echo
        echo "Available MCP packs in $TEMPLATE_ROOT/packs/:"
        for d in "$TEMPLATE_ROOT/packs"/mcp-*/; do
          [ -d "$d" ] && echo "  $(basename "$d" | sed 's/^mcp-//')"
        done
        return 0
      fi
      echo "Installed MCP packs:"
      sed 's/^/  /' "$manifest"
      ;;
    install)
      [ "${#names[@]}" -gt 0 ] || { echo "⚠ Usage: richardbot-init mcp install <name> [name...] [--keys-from <file>] [--yes] [target-dir]" >&2; exit 2; }
      [ -d "$target/.claude" ] || { echo "⚠ Target has no .claude/ — run 'init' first." >&2; exit 2; }

      # Load keys from file if --keys-from given (KEY=value lines; 'export' prefix optional).
      declare -A keys_env=()
      if [ -n "$keys_from" ]; then
        [ -f "$keys_from" ] || { echo "⚠ --keys-from file not found: $keys_from" >&2; exit 2; }
        while IFS= read -r line; do
          [ -z "$line" ] && continue
          [ "${line#\#}" != "$line" ] && continue
          line="${line#export }"
          local k="${line%%=*}"
          local v="${line#*=}"
          v="${v#\"}"; v="${v%\"}"
          [ -n "$k" ] && keys_env["$k"]="$v"
        done < "$keys_from"
      fi

      local env_file="$target/.claude/env"
      mkdir -p "$(dirname "$env_file")"
      touch "$env_file"

      local mcp_file="$target/.mcp.json"
      local current_json='{"mcpServers": {}}'
      if [ -f "$mcp_file" ]; then
        current_json="$(cat "$mcp_file")"
        if ! echo "$current_json" | jq -e '.mcpServers' >/dev/null 2>&1; then
          current_json="$(echo "$current_json" | jq '. + {mcpServers: {}}')"
        fi
      fi

      local template_json
      template_json="$(cat "$template")"

      for name in "${names[@]}"; do
        local pack_dir="$TEMPLATE_ROOT/packs/mcp-$name"
        [ -d "$pack_dir" ] || { echo "⚠ Unknown MCP: '$name' (no $pack_dir)" >&2; continue; }

        local stanza
        # If the key is absent in the template, jq must not blow up — gate the with_entries on null.
        stanza="$(echo "$template_json" | jq --arg n "$name" 'if .mcpServers[$n] == null then null else .mcpServers[$n] | with_entries(select(.key | startswith("_comment") | not)) end')"
        if [ "$stanza" = "null" ]; then
          echo "⚠ '$name' is not in .mcp.json.template (skipping)" >&2
          continue
        fi

        echo "→ Installing MCP pack: $name"
        echo "  See packs/mcp-$name/README.md for full setup notes."

        local env_keys
        env_keys="$(echo "$stanza" | jq -r '.env // {} | keys[]')"

        if [ -n "$env_keys" ]; then
          while IFS= read -r key; do
            [ -z "$key" ] && continue
            local value=""
            if grep -qE "^[[:space:]]*export[[:space:]]+$key=" "$env_file" 2>/dev/null; then
              echo "  ✓ $key (already in $env_file — preserved)"
              continue
            elif [ -n "${keys_env[$key]:-}" ]; then
              value="${keys_env[$key]}"
              echo "  ✓ $key (from --keys-from)"
            elif [ "$non_interactive" = "1" ]; then
              echo "  ⚠ $key — non-interactive, no value provided (leaving blank)" >&2
              value=""
            else
              read -r -p "  Enter $key (or blank to defer): " value
            fi

            if [ -n "$value" ]; then
              echo "export $key=\"$value\"" >> "$env_file"
            fi
          done <<< "$env_keys"
        fi

        current_json="$(echo "$current_json" | jq --arg n "$name" --argjson stanza "$stanza" \
                          '.mcpServers[$n] = $stanza')"

        touch "$target/.claude/MCPS"
        if ! grep -qxF "$name" "$target/.claude/MCPS" 2>/dev/null; then
          echo "$name" >> "$target/.claude/MCPS"
        fi

        echo "  ✓ stanza added to $mcp_file"
      done

      echo "$current_json" | jq . > "$mcp_file"

      echo
      echo "✓ MCP install complete."
      echo "  • $mcp_file updated"
      echo "  • $env_file appended with new env vars (review before committing)"
      echo "  • .claude/MCPS manifest updated"
      echo
      echo "Next:"
      echo "  1. If any stanza shows PACKAGE_NAME_TBD, edit .mcp.json with the verified"
      echo "     package name (see each pack's README for where to find it)."
      echo "  2. Restart Claude Code so the MCP server loads."
      echo "  3. Verify with 'richardbot-init mcp list'."
      ;;
    remove)
      [ "${#names[@]}" -gt 0 ] || { echo "⚠ Usage: richardbot-init mcp remove <name> [target-dir]" >&2; exit 2; }
      local mcp_file="$target/.mcp.json"
      [ -f "$mcp_file" ] || { echo "⚠ No $mcp_file — nothing to remove." >&2; exit 2; }

      local current_json
      current_json="$(cat "$mcp_file")"
      for name in "${names[@]}"; do
        if echo "$current_json" | jq -e --arg n "$name" '.mcpServers[$n]' >/dev/null 2>&1; then
          current_json="$(echo "$current_json" | jq --arg n "$name" 'del(.mcpServers[$n])')"
          echo "✓ removed MCP stanza: $name"
        else
          echo "  (no stanza for '$name' in $mcp_file — skipping)" >&2
        fi
        if [ -f "$target/.claude/MCPS" ]; then
          grep -v "^$name$" "$target/.claude/MCPS" > "$target/.claude/MCPS.tmp" 2>/dev/null || true
          mv "$target/.claude/MCPS.tmp" "$target/.claude/MCPS"
          [ -s "$target/.claude/MCPS" ] || rm -f "$target/.claude/MCPS"
        fi
      done

      echo "$current_json" | jq . > "$mcp_file"

      echo
      echo "Note: env-var lines in $target/.claude/env were preserved. Edit manually if you want to remove them too."
      ;;
    *)
      echo "⚠ Unknown mcp sub-command: $sub" >&2
      echo "    Usage: richardbot-init mcp <list|install|remove> [args]" >&2
      exit 2
      ;;
  esac
}

case "$mode" in
  help|--help|-h) usage ;;
esac

# `pack` takes a sub-command as $2 (list/add/remove); target is parsed inside do_pack.
# All other modes take target as $2 (defaults to pwd).
if [ "$mode" = "pack" ] || [ "$mode" = "mcp" ]; then
  target="$(pwd)"
else
  target="${2:-$(pwd)}"
  target="$(cd "$target" && pwd)"
fi

echo "richardbot-init: $mode → $target"
echo "template:         $TEMPLATE_ROOT"
echo

# ── init ────────────────────────────────────────────────────────────────────
do_init() {
  # Parse init-mode flags. Positional args were already consumed by mode/target
  # parsing at the top of the script; what remains in $@ are flags only.
  local pack_name=""
  local full="0"
  local overview=""
  local force="0"

  # Skip past "init" and any positional target dir (already absorbed globally)
  shift 1 2>/dev/null || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --pack)     pack_name="${2:-}"; shift 2 ;;
      --full)     full="1"; shift ;;
      --overview) overview="${2:-}"; shift 2 ;;
      --force)    force="1"; shift ;;
      --*)        echo "⚠ unknown init flag: $1" >&2; shift ;;
      *)          shift ;;  # silently drop positional (already consumed)
    esac
  done

  # Refuse to overwrite an existing install unless --force
  if { [ -f "$target/CLAUDE.md" ] || [ -d "$target/.claude" ]; } && [ "$force" != "1" ]; then
    echo "⚠ Target already has CLAUDE.md or .claude/ — refusing to overwrite."
    echo "  Use 'richardbot-init update' instead, or pass --force to nuke + reinstall."
    exit 2
  fi

  mkdir -p "$target/.claude/hooks" \
           "$target/.claude/rules" \
           "$target/.claude/commands" \
           "$target/.richardbot-memory"

  # Copy all hooks (auto-picks-up new ones added to the template)
  for hook_src in "$TEMPLATE_ROOT/.claude/hooks/"*.sh; do
    [ -f "$hook_src" ] || continue
    cp "$hook_src" "$target/.claude/hooks/$(basename "$hook_src")"
    chmod +x "$target/.claude/hooks/$(basename "$hook_src")"
  done

  cp "$TEMPLATE_ROOT/.claude/settings.json" \
     "$target/.claude/settings.json"

  # Copy all starter rules (README + conventions + secrets + pr-flow + any others)
  for rule_src in "$TEMPLATE_ROOT/.claude/rules/"*.md; do
    [ -f "$rule_src" ] || continue
    cp "$rule_src" "$target/.claude/rules/$(basename "$rule_src")"
  done

  cp "$TEMPLATE_ROOT/.richardbot-memory/README.md" "$target/.richardbot-memory/README.md"
  cp "$TEMPLATE_ROOT/.richardbot-memory/_recent.md" "$target/.richardbot-memory/_recent.md"

  # Scaffold .github/copilot-instructions.md from minute one — NOT gated behind
  # --full. The honesty+completion discipline and the manual memory protocol
  # don't depend on any rules existing, so a bare init yields a working Copilot
  # discipline file immediately. The sentinel splits the preserved preamble
  # (above) from the generated region (below); 'copilot-mirror' fills the latter.
  local copilot_sentinel='<!-- BEGIN richardbot-mirror — generated; everything below is overwritten on re-run -->'
  if [ -f "$TEMPLATE_ROOT/assets/copilot-preamble.md" ]; then
    mkdir -p "$target/.github"
    {
      cat "$TEMPLATE_ROOT/assets/copilot-preamble.md"
      printf '\n%s\n\n' "$copilot_sentinel"
      printf '<!-- Generated region. Run `richardbot-init copilot-mirror` to fold\n'
      printf '`.claude/rules/*.md` + `.richardbot-memory/*.md` in here. -->\n'
    } > "$target/.github/copilot-instructions.md"
  fi

  # Copy role files
  for role_src in "$TEMPLATE_ROOT/.claude/commands/"*.md; do
    [ -f "$role_src" ] || continue
    cp "$role_src" "$target/.claude/commands/$(basename "$role_src")"
  done

  # gitignore.recommended at template root — copy with a clear name so users
  # can decide what to merge into their actual .gitignore
  cp "$TEMPLATE_ROOT/gitignore.recommended" "$target/.richardbot-gitignore.recommended"

  # CLAUDE.md spine template — copy with project-name interpolated
  project_name="$(basename "$target")"
  sed "s|<PROJECT NAME>|$project_name|g" "$TEMPLATE_ROOT/CLAUDE.md" \
    > "$target/CLAUDE.md"
  # Bundle the tool itself + packs into the target so subsequent ops
  # (update/verify/pack add) work standalone without depending on where
  # the original template lives. Important for codespace / CI consumers.
  mkdir -p "$target/bin"
  cp "$TEMPLATE_ROOT/bin/richardbot-init" "$target/bin/richardbot-init"
  chmod +x "$target/bin/richardbot-init"

  if [ -d "$TEMPLATE_ROOT/packs" ]; then
    mkdir -p "$target/packs"
    [ -f "$TEMPLATE_ROOT/packs/README.md" ] && \
      cp "$TEMPLATE_ROOT/packs/README.md" "$target/packs/README.md"
    for pack_dir in "$TEMPLATE_ROOT/packs"/*/; do
      [ -d "$pack_dir" ] || continue
      # Use a distinct name so we don't shadow the outer pack_name flag-state.
      local _pack_basename
      _pack_basename="$(basename "$pack_dir")"
      mkdir -p "$target/packs/$_pack_basename"
      for f in "$pack_dir"*.md; do
        [ -f "$f" ] || continue
        cp "$f" "$target/packs/$_pack_basename/$(basename "$f")"
      done
    done
  fi

  # Bundle assets/ (the Copilot discipline preamble) so the bundled bin can
  # regenerate .github/copilot-instructions.md standalone — same reason packs/
  # are bundled above.
  if [ -d "$TEMPLATE_ROOT/assets" ]; then
    mkdir -p "$target/assets"
    for asset_src in "$TEMPLATE_ROOT/assets/"*; do
      [ -f "$asset_src" ] || continue
      cp "$asset_src" "$target/assets/$(basename "$asset_src")"
    done
  fi


  # Write framework integrity manifest for 'verify' mode
  ( cd "$target" && find .claude/hooks .claude/settings.json \
       -type f -exec sha256sum {} \; 2>/dev/null | sort ) \
    > "$target/.claude/INSTALLED" 2>/dev/null || true

  echo "✓ Installed richardbot template skeleton."

  local bundled_bin="$target/bin/richardbot-init"

  # ── Optional --pack <name>: install a stack-specific rule bundle ─────────
  if [ -n "$pack_name" ]; then
    echo
    echo "→ Installing pack: $pack_name"
    bash "$bundled_bin" pack add "$pack_name" "$target" 2>&1 | sed 's/^/  /'
  fi

  # ── Optional --full: run the autopopulate chain ──────────────────────────
  # Costs: seed ~$1-2 + rescan ~$2-3 (haiku subprocesses). import-overview is
  # free. copilot-mirror is free. Operator opted in by passing --full.
  if [ "$full" = "1" ]; then
    echo
    echo "──────────────────────────────────────────────────────────────"
    echo "→ --full autopopulate: spawning Haiku subprocesses (est \$3-5)"
    echo "──────────────────────────────────────────────────────────────"

    echo
    echo "──── 1/4: seed (per-surface fragments) ────"
    bash "$bundled_bin" seed "$target" --write 2>&1 | sed 's/^/  /'

    if [ -n "$overview" ]; then
      if [ ! -f "$overview" ]; then
        echo
        echo "⚠ --overview path not found: $overview (skipping import step)" >&2
      else
        echo
        echo "──── 2/4: import-overview (split monolithic md → fragments) ────"
        bash "$bundled_bin" import-overview "$target" "$overview" 2>&1 | sed 's/^/  /'
      fi
    else
      echo
      echo "──── 2/4: import-overview — skipped (no --overview path given) ────"
    fi

    echo
    echo "──── 3/4: rescan (populate .richardbot-memory/ bug findings) ────"
    bash "$bundled_bin" rescan "$target" --no-mirror 2>&1 | sed 's/^/  /'

    echo
    echo "──── 4/4: copilot-mirror (generate .github/ for Copilot) ────"
    bash "$bundled_bin" copilot-mirror "$target" 2>&1 | sed 's/^/  /'

    echo
    echo "──────────────────────────────────────────────────────────────"
    echo "✓ Full install complete. Test:"
    echo "    echo '{\"prompt\":\"what is the structure\"}' | bash $target/.claude/hooks/prompt-fragment-loader.sh | jq -r .hookSpecificOutput.additionalContext | head -40"
    echo "──────────────────────────────────────────────────────────────"
  else
    echo
    echo "  Next:"
    echo "    1. Edit CLAUDE.md — fill in the placeholder sections."
    echo "    2. Run 'richardbot-init survey' to see detected surfaces."
    echo "    3. Run 'richardbot-init seed --write' to auto-generate surface fragments."
    echo "    4. Run 'richardbot-init rescan' to populate memory with bug findings."
    echo "    5. Run 'richardbot-init copilot-mirror' to generate .github/ for Copilot."
    echo
    echo "    Or do all of the above in one shot:"
    echo "      richardbot-init init --full [--pack <stack>] [--overview <existing.md>]"
  fi
}

# ── survey ──────────────────────────────────────────────────────────────────
do_survey() {
  echo "## Stack detected"
  echo

  local stack=()
  [ -f "$target/package.json" ] && stack+=("Node.js (package.json)")
  [ -f "$target/pyproject.toml" ] && stack+=("Python (pyproject.toml)")
  [ -f "$target/Cargo.toml" ] && stack+=("Rust (Cargo.toml)")
  [ -f "$target/go.mod" ] && stack+=("Go (go.mod)")
  [ -f "$target/Gemfile" ] && stack+=("Ruby (Gemfile)")

  # Shopify signals
  if compgen -G "$target/shopify.app.*.toml" > /dev/null 2>&1 \
     || [ -f "$target/shopify.app.toml" ]; then
    stack+=("Shopify App (shopify.app*.toml)")
  fi
  if [ -d "$target/extensions" ]; then
    stack+=("Shopify Functions / Extensions (extensions/)")
  fi
  if [ -d "$target/sections" ] && [ -d "$target/templates" ] && [ -d "$target/snippets" ]; then
    stack+=("Shopify Theme (sections + templates + snippets)")
  fi

  # Framework signals from package.json
  if [ -f "$target/package.json" ] && command -v jq >/dev/null 2>&1; then
    local deps
    deps="$(jq -r '(.dependencies // {}) + (.devDependencies // {}) | keys[]' "$target/package.json" 2>/dev/null || true)"
    grep -q '^@remix-run/' <<<"$deps" && stack+=("Remix")
    grep -q '^next$' <<<"$deps" && stack+=("Next.js")
    grep -q '^vue$' <<<"$deps" && stack+=("Vue")
    grep -q '^react$' <<<"$deps" && stack+=("React")
    grep -q '^vitest$' <<<"$deps" && stack+=("vitest")
    grep -q '^jest$' <<<"$deps" && stack+=("jest")
    grep -q '^@shopify/polaris$' <<<"$deps" && stack+=("Shopify Polaris")
    grep -q '^@shopify/shopify-app-remix$' <<<"$deps" && stack+=("Shopify App Remix")
  fi

  if [ "${#stack[@]}" -eq 0 ]; then
    echo "  (no recognized stack signals)"
  else
    for s in "${stack[@]}"; do echo "- $s"; done
  fi
  echo

  echo "## Proposed surface chunks"
  echo
  echo "Each suggestion below maps to a candidate \`.claude/rules/surface-*.md\`"
  echo "fragment. Pick what fits; author the body; let unused suggestions go."
  echo

  # Heuristic: per-page entry points in src/*.js or src/*.ts
  if [ -d "$target/src" ]; then
    while IFS= read -r entry; do
      local base="$(basename "$entry" | sed 's/\.[jt]sx\?$//')"
      case "$base" in
        index|main|app|theme|password) continue ;; # skip generic
      esac
      echo "- \`surface-$base.md\` — entry point \`src/$base.{js,ts}\`"
    done < <(find "$target/src" -maxdepth 1 -type f \( -name '*.js' -o -name '*.ts' -o -name '*.tsx' -o -name '*.jsx' \) 2>/dev/null)
  fi

  # Heuristic: per-route file in app/routes/ (Remix)
  if [ -d "$target/app/routes" ]; then
    while IFS= read -r route; do
      local base="$(basename "$route" | sed 's/\.[jt]sx\?$//' | tr '.' '-')"
      [ "$base" = "_index" ] && base="index"
      echo "- \`surface-route-$base.md\` — Remix route \`app/routes/$(basename "$route")\`"
    done < <(find "$target/app/routes" -maxdepth 1 -type f -name '*.jsx' -o -name '*.tsx' 2>/dev/null | head -8)
  fi

  # Heuristic: per-extension dir (Shopify Functions / Extensions)
  if [ -d "$target/extensions" ]; then
    while IFS= read -r ext; do
      [ -d "$ext" ] || continue
      local base="$(basename "$ext")"
      echo "- \`surface-extension-$base.md\` — Shopify extension \`extensions/$base/\`"
    done < <(find "$target/extensions" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
  fi

  # Heuristic: per-Vue component domain (src/components/*/ or src/vue/components/*/)
  for vue_root in "$target/src/components" "$target/src/vue/components"; do
    if [ -d "$vue_root" ]; then
      while IFS= read -r domain; do
        [ -d "$domain" ] || continue
        local base="$(basename "$domain")"
        echo "- \`surface-vue-$base.md\` — Vue component tree \`${vue_root#$target/}/$base/\`"
      done < <(find "$vue_root" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -10)
    fi
  done

  echo
  echo "## Cross-cutting suggestions"
  echo
  echo "- \`deploy.md\` — deploy targets + envs + gates (always relevant)"
  echo "- \`pr-flow.md\` — PR conventions + review gates + merge policy"
  echo "- \`perf-gate.md\` — if Lighthouse / bundle-size budgets exist"
  if [ -d "$target/extensions" ] || [ -f "$target/vitest.config.js" ] || [ -f "$target/vitest.config.ts" ]; then
    echo "- \`testing.md\` — vitest conventions, coverage targets, fixture patterns"
  fi
}

# ── update ──────────────────────────────────────────────────────────────────
do_update() {
  if [ ! -d "$target/.claude" ]; then
    echo "⚠ Target has no .claude/ — run 'richardbot-init init' first."
    exit 2
  fi

  # Update only the framework files; preserve project-authored rules/memory/CLAUDE.md
  for hook_src in "$TEMPLATE_ROOT/.claude/hooks/"*.sh; do
    [ -f "$hook_src" ] || continue
    cp "$hook_src" "$target/.claude/hooks/$(basename "$hook_src")"
    chmod +x "$target/.claude/hooks/$(basename "$hook_src")"
  done

  cp "$TEMPLATE_ROOT/.claude/settings.json" \
     "$target/.claude/settings.json"

  cp "$TEMPLATE_ROOT/.claude/rules/README.md" "$target/.claude/rules/README.md"
  cp "$TEMPLATE_ROOT/.richardbot-memory/README.md" "$target/.richardbot-memory/README.md"

  # Refresh integrity manifest
  ( cd "$target" && find .claude/hooks .claude/settings.json \
       -type f -exec sha256sum {} \; 2>/dev/null | sort ) \
    > "$target/.claude/INSTALLED" 2>/dev/null || true

  # Role files: only update if the project hasn't customized them.
  for role in architect dev qa scan postmortem; do
    local src="$TEMPLATE_ROOT/.claude/commands/$role.md"
    local dst="$target/.claude/commands/$role.md"
    if [ ! -f "$dst" ] || cmp -s "$src" "$dst" 2>/dev/null; then
      cp "$src" "$dst"
    else
      echo "  (preserved customized $role.md)"
    fi
  done

  echo "✓ Updated framework files. Project-authored content preserved."
}

# ── uninstall ───────────────────────────────────────────────────────────────
# Removes framework files only. Preserves:
#   - CLAUDE.md (user-edited spine)
#   - .claude/rules/<user-authored>.md (anything not shipped by us)
#   - .claude/commands/<role>.md customizations
#   - All of .richardbot-memory/ (agent-grown content)
# The end state is "framework removed, your content survives." Re-install
# later via `init`, then `update` to bring the framework back fresh.
do_uninstall() {
  if [ ! -d "$target/.claude" ] && [ ! -d "$target/.richardbot-memory" ] && [ ! -f "$target/CLAUDE.md" ]; then
    echo "⚠ Nothing to uninstall — no .claude/, no .richardbot-memory/, no CLAUDE.md."
    exit 2
  fi

  # Files we ship — safe to remove
  rm -f "$target/.claude/hooks/prompt-fragment-loader.sh"
  rm -f "$target/.claude/settings.json"
  rm -f "$target/.claude/rules/README.md"
  rm -f "$target/.richardbot-memory/README.md"

  # Role files: only remove if unchanged from template (cmp -s).
  for role in architect dev qa scan postmortem; do
    local src="$TEMPLATE_ROOT/.claude/commands/$role.md"
    local dst="$target/.claude/commands/$role.md"
    if [ -f "$dst" ] && cmp -s "$src" "$dst" 2>/dev/null; then
      rm -f "$dst"
    elif [ -f "$dst" ]; then
      echo "  (preserved customized $role.md — remove manually if unwanted)"
    fi
  done

  # Starter rules: remove if unchanged from template
  for starter in conventions.md example-surface.md; do
    local src="$TEMPLATE_ROOT/.claude/rules/$starter"
    local dst="$target/.claude/rules/$starter"
    if [ -f "$dst" ] && cmp -s "$src" "$dst" 2>/dev/null; then
      rm -f "$dst"
    fi
  done

  # _recent.md: remove if it has the skeleton shape (no real entries beyond the header)
  local recent="$target/.richardbot-memory/_recent.md"
  if [ -f "$recent" ] && cmp -s "$TEMPLATE_ROOT/.richardbot-memory/_recent.md" "$recent" 2>/dev/null; then
    rm -f "$recent"
  fi

  # Empty hooks/ dir → remove
  rmdir "$target/.claude/hooks" 2>/dev/null || true

  # If .claude/rules/ now has only user-authored files, leave it.
  # If empty, remove.
  rmdir "$target/.claude/rules" 2>/dev/null || true
  rmdir "$target/.claude/commands" 2>/dev/null || true
  rmdir "$target/.claude" 2>/dev/null || true
  rmdir "$target/.richardbot-memory" 2>/dev/null || true

  echo "✓ Framework files removed. User-authored content preserved."
  echo "  Surviving files (if any) — review and remove manually if unwanted:"
  find "$target/.claude" "$target/.richardbot-memory" "$target/CLAUDE.md" -type f 2>/dev/null | sed 's/^/    /'
}

# ── nuke ────────────────────────────────────────────────────────────────────
# Removes EVERYTHING the template ever touches at the repo root.
# Destructive — confirms before running unless --yes flag is set.
do_nuke() {
  echo "⚠ NUKE mode — about to remove:"
  echo "    $target/CLAUDE.md"
  echo "    $target/.claude/"
  echo "    $target/.richardbot-memory/"
  echo
  if [ "${3:-}" != "--yes" ] && [ "${RICHARDBOT_NUKE_CONFIRM:-}" != "yes" ]; then
    read -r -p "Confirm with 'yes' to proceed: " ans
    [ "$ans" = "yes" ] || { echo "aborted"; exit 1; }
  fi
  rm -f  "$target/CLAUDE.md"
  rm -rf "$target/.claude"
  rm -rf "$target/.richardbot-memory"
  echo "✓ Nuked."
}

# ── seed ────────────────────────────────────────────────────────────────────
# Auto-generate surface fragments by dispatching `claude --print --model <X>`
# subprocesses against each functional surface in the repo. Reads the source;
# writes (optionally) into .claude/rules/. Per-fragment cost reported on stderr.
#
# Strategy: one subprocess per surface, run sequentially (parallelism left as
# a follow-up — keeps the first cut readable + bounds total cost predictably).
do_seed() {
  local model="haiku"
  local one_surface=""
  local write_mode="0"

  # Parse opts (args 3..N — $1 is mode, $2 is target)
  shift 2 || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --surface) one_surface="$2"; shift 2 ;;
      --model)   model="$2"; shift 2 ;;
      --write)   write_mode="1"; shift ;;
      *) echo "⚠ unknown seed option: $1" >&2; shift ;;
    esac
  done

  command -v claude >/dev/null 2>&1 || { echo "⚠ 'claude' CLI not on PATH" >&2; exit 2; }
  command -v jq     >/dev/null 2>&1 || { echo "⚠ 'jq' not on PATH" >&2; exit 2; }

  if [ "$write_mode" = "1" ] && [ ! -d "$target/.claude/rules" ]; then
    echo "⚠ Target has no .claude/rules/ — run 'init' first." >&2
    exit 2
  fi

  # Build the surface list. If --surface given, use only that one;
  # otherwise enumerate from directory shape (same heuristic as `survey`).
  local surfaces=()
  if [ -n "$one_surface" ]; then
    surfaces=("$one_surface")
  else
    # Page entries: src/*.{js,ts}
    if [ -d "$target/src" ]; then
      while IFS= read -r entry; do
        local base
        base="$(basename "$entry" | sed 's/\.[jt]sx\?$//')"
        case "$base" in
          index|main|app|theme|password|tailwind.config) continue ;;
        esac
        surfaces+=("src/$base.js")
      done < <(find "$target/src" -maxdepth 1 -type f \
                 \( -name '*.js' -o -name '*.ts' -o -name '*.tsx' -o -name '*.jsx' \) 2>/dev/null)
    fi
    # Vue component domains
    for vroot in "$target/src/components" "$target/src/vue/components"; do
      [ -d "$vroot" ] || continue
      while IFS= read -r d; do
        [ -d "$d" ] || continue
        surfaces+=("${vroot#$target/}/$(basename "$d")")
      done < <(find "$vroot" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
    done
    # Shopify extensions
    if [ -d "$target/extensions" ]; then
      while IFS= read -r d; do
        [ -d "$d" ] || continue
        surfaces+=("extensions/$(basename "$d")")
      done < <(find "$target/extensions" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
    fi
  fi

  if [ "${#surfaces[@]}" -eq 0 ]; then
    echo "⚠ No surfaces detected. Try 'survey' first or pass --surface <path>." >&2
    exit 2
  fi

  local total_cost="0"
  for surf in "${surfaces[@]}"; do
    local abs="$target/$surf"
    if [ ! -e "$abs" ]; then
      echo "⚠ surface not found: $abs" >&2
      continue
    fi

    # Build a fragment name from the surface path
    local name
    name="surface-$(echo "$surf" | sed -e 's|^src/||' -e 's|^src/vue/components/||' \
                                       -e 's|^src/components/||' -e 's|^extensions/||' \
                                       -e 's|\.[jt]sx\?$||' -e 's|/|-|g').md"

    echo "→ seeding $surf → $name (model=$model)" >&2

    # Build the dispatch prompt — tight, role-shaped, format-constrained.
    # Critical: the first character of your output MUST be '-' (the start of '---').
    local prompt
    prompt="$(cat <<EOF
You are a code surface scanner. Read the directory $surf inside the current repo and produce a single \`.md\` rule fragment for the richardbot context system.

YOUR OUTPUT BEGINS WITH '---'. NO PREAMBLE. NO "Here is..." or "Now I'll...". NO TRAILING COMMENTARY. JUST THE FRAGMENT.

EXACT frontmatter shape (copy the structure, fill in the values; do NOT flatten the triggers block):

---
description: <one-sentence summary of what this surface covers>
alwaysApply: false
triggers:
  prompt:
    - "<token-1>"
    - "<token-2>"
    - "<token-3>"
globs:
  - "<glob-pattern-1>"
  - "<glob-pattern-2>"
---

Then a markdown body with these H2 sections in order:
  ## What lives here   — bullet list of components/files with one-line purpose each
  ## Conventions       — bullets of patterns/rules specific to this surface
  ## Known fragilities — bullets of gotchas you can infer from the code (write "none observed" if honest)
  ## How to verify     — bullets of how an engineer would test changes here

CONSTRAINTS:
- ≤80 lines total including frontmatter.
- File:line citations when you reference something. Don't speculate.
- If a section has nothing real to say, write "none observed" — do not pad.
- 3–6 prompt tokens. 1–3 globs. Tokens should be word-boundary-matchable (no whitespace inside a single token unless the engineer would actually type that phrase).

SCOPE: $surf only. Do not read or describe files outside that directory.

Run \`ls $surf\` and \`cat\` the most important files inside it, then output the fragment beginning with '---'.
EOF
)"

    # Dispatch from inside the target dir so the subprocess can `ls`/`cat` paths relative to repo root.
    # Soft-fail on subprocess non-zero — let us inspect the response below.
    local out_json
    set +e
    out_json="$(cd "$target" && claude --print --model "$model" \
                  --output-format json \
                  --permission-mode bypassPermissions \
                  --max-turns 15 \
                  "$prompt")"
    local rc=$?
    set -e
    if [ $rc -ne 0 ]; then
      echo "  ⚠ subprocess exit code $rc; response below if any" >&2
    fi

    if [ -z "$out_json" ]; then
      echo "  ⚠ empty response" >&2
      continue
    fi

    local body cost
    body="$(printf '%s' "$out_json" | jq -r '.result // empty')"
    cost="$(printf '%s' "$out_json" | jq -r '.total_cost_usd // 0')"
    total_cost="$(awk -v a="$total_cost" -v b="$cost" 'BEGIN{printf "%.4f", a+b}')"

    # ── Post-process: strip preamble; collapse duplicate '---' opener ─────
    # 1. Drop everything before the FIRST '---' line so any "Now I'll produce..."
    #    or markdown code-fence chrome is removed.
    body="$(printf '%s\n' "$body" | awk '
      BEGIN { found = 0 }
      /^---[[:space:]]*$/ { found = 1 }
      found
    ')"
    # 2. If output has two consecutive "---" lines at the top (model emitted a
    #    leading fence AND a frontmatter opener), drop the first one.
    if printf '%s\n' "$body" | head -2 | awk '/^---[[:space:]]*$/' | wc -l | grep -q '^2$'; then
      body="$(printf '%s\n' "$body" | tail -n +2)"
    fi
    # 3. Detect & flag schema violations on the frontmatter (we don't auto-fix,
    #    we surface them so the seed run is observable).
    local fm_warnings=""
    if ! printf '%s\n' "$body" | head -25 | grep -q '^  prompt:'; then
      fm_warnings="${fm_warnings}\n  ⚠ triggers.prompt not nested correctly — re-prompt may be needed"
    fi
    if ! printf '%s\n' "$body" | head -25 | grep -q '^description:'; then
      fm_warnings="${fm_warnings}\n  ⚠ description field missing"
    fi

    echo "  ✓ done (\$$cost)" >&2
    [ -n "$fm_warnings" ] && printf '%b\n' "$fm_warnings" >&2

    if [ "$write_mode" = "1" ]; then
      printf '%s\n' "$body" > "$target/.claude/rules/$name"
      echo "  ↳ wrote .claude/rules/$name ($(wc -l < "$target/.claude/rules/$name") lines)" >&2
    else
      echo "=== $name ==="
      printf '%s\n' "$body"
      echo
    fi
  done

  echo >&2
  echo "Total cost: \$$total_cost across ${#surfaces[@]} surface(s)" >&2
}

# ── rescan ──────────────────────────────────────────────────────────────────
# Periodic refresh of bug findings. For each surface, dispatch a Haiku (or
# bigger) subprocess to look for concrete file:line bugs, then write the
# results to .richardbot-memory/<surface-slug>-bugs-YYYY-MM-DD.md. Any prior
# bug-note for the same surface (different date) is moved into
# .richardbot-memory/.archive/ so the audit trail is preserved.
#
# Default scope is ALL detected surfaces. --since "7 days ago" trims to only
# surfaces with files touched by git in that window — typical weekly-cron mode.
#
# After rescanning, copilot-mirror runs automatically so the new findings reach
# both Claude Code (via the loader hook) and Copilot (via .github/instructions/).
do_rescan() {
  local model="haiku"
  local one_surface=""
  local since=""
  local age_out=""
  local run_mirror="1"

  shift 2 || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --surface)   one_surface="$2"; shift 2 ;;
      --model)     model="$2"; shift 2 ;;
      --since)     since="$2"; shift 2 ;;
      --age-out)   age_out="$2"; shift 2 ;;
      --no-mirror) run_mirror="0"; shift ;;
      *) echo "⚠ unknown rescan option: $1" >&2; shift ;;
    esac
  done

  command -v claude >/dev/null 2>&1 || { echo "⚠ 'claude' CLI not on PATH" >&2; exit 2; }
  command -v jq     >/dev/null 2>&1 || { echo "⚠ 'jq' not on PATH" >&2; exit 2; }

  [ -d "$target/.richardbot-memory" ] || mkdir -p "$target/.richardbot-memory"
  local archive_dir="$target/.richardbot-memory/.archive"

  # ── Surface enumeration (same heuristic as do_seed) ──────────────────────
  local surfaces=()
  if [ -n "$one_surface" ]; then
    surfaces=("$one_surface")
  else
    if [ -d "$target/src" ]; then
      while IFS= read -r entry; do
        local base
        base="$(basename "$entry" | sed 's/\.[jt]sx\?$//')"
        case "$base" in
          index|main|app|theme|password|tailwind.config) continue ;;
        esac
        surfaces+=("src/$base.js")
      done < <(find "$target/src" -maxdepth 1 -type f \
                 \( -name '*.js' -o -name '*.ts' -o -name '*.tsx' -o -name '*.jsx' \) 2>/dev/null)
    fi
    for vroot in "$target/src/components" "$target/src/vue/components"; do
      [ -d "$vroot" ] || continue
      while IFS= read -r d; do
        [ -d "$d" ] || continue
        surfaces+=("${vroot#$target/}/$(basename "$d")")
      done < <(find "$vroot" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
    done
    if [ -d "$target/extensions" ]; then
      while IFS= read -r d; do
        [ -d "$d" ] || continue
        surfaces+=("extensions/$(basename "$d")")
      done < <(find "$target/extensions" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
    fi
  fi

  if [ "${#surfaces[@]}" -eq 0 ]; then
    echo "⚠ No surfaces detected." >&2
    exit 2
  fi

  # ── --since filter: keep only surfaces with files touched in the window ─
  if [ -n "$since" ]; then
    if ! git -C "$target" rev-parse --git-dir >/dev/null 2>&1; then
      echo "⚠ --since requires target to be a git repo; ignoring" >&2
    else
      local touched
      touched="$(git -C "$target" log --since="$since" --name-only --pretty=format: 2>/dev/null \
                 | grep -v '^$' | sort -u)"
      local filtered=()
      for surf in "${surfaces[@]}"; do
        if printf '%s\n' "$touched" | grep -q "^${surf}/"; then
          filtered+=("$surf")
        elif printf '%s\n' "$touched" | grep -qx "$surf"; then
          filtered+=("$surf")
        fi
      done
      surfaces=("${filtered[@]}")
      echo "→ --since '$since' filtered to ${#surfaces[@]} surface(s)" >&2
    fi
  fi

  if [ "${#surfaces[@]}" -eq 0 ]; then
    echo "✓ Nothing to rescan in --since window. Done." >&2
    return 0
  fi

  local today
  today="$(date +%Y-%m-%d)"
  local total_cost="0"
  local rescanned=0

  for surf in "${surfaces[@]}"; do
    local abs="$target/$surf"
    if [ ! -e "$abs" ]; then
      echo "⚠ surface not found: $abs (skipping)" >&2
      continue
    fi

    local slug
    slug="$(echo "$surf" | sed -e 's|^src/||' -e 's|^src/vue/components/||' \
                              -e 's|^src/components/||' -e 's|^extensions/||' \
                              -e 's|\.[jt]sx\?$||' -e 's|/|-|g')"
    local out_name=".richardbot-memory/${slug}-bugs-${today}.md"

    echo "→ rescanning $surf → $out_name (model=$model)" >&2

    local prompt
    prompt="$(cat <<EOF
You are a code-quality reviewer producing a bug-findings memo for the richardbot context system. Scan ONLY the directory $surf and find concrete bugs.

YOUR OUTPUT BEGINS WITH '---'. NO PREAMBLE. NO "Here are the bugs...". JUST THE FRAGMENT.

EXACT frontmatter shape:

---
description: Bug findings from periodic rescan of $surf on ${today}. File:line citations. File these as tickets / fixes.
date: ${today}
type: friction
surface: $surf
triggers:
  prompt:
    - "<bug-keyword-1>"
    - "<bug-keyword-2>"
    - "<bug-keyword-3>"
---

Then a markdown body with these H2 sections, in order, each populated only if you have CONCRETE findings:

  ## Severity: high (security)     — XSS, unsanitized HTML, exposed secrets, auth bypass, SQL injection
  ## Severity: high (correctness)  — bugs that break behavior: wrong operator, wrong API usage, dead code paths
  ## Severity: medium              — race conditions, missing error handling, mutable shared state, broken edge cases
  ## Severity: low (hygiene)       — console.log/error in shipped code, missing null guards, unused imports, dead branches
  ## Provenance                    — one sentence: "Surfaced by haiku rescan of \`$surf\` on ${today}. File:line citations verified against the codebase at scan time."

CONSTRAINTS:
- Every bullet must have a file:line citation. No speculation, no "could be a bug". Read the code, cite the line.
- If a severity has no findings, OMIT that section. Don't pad with "none observed".
- 3–8 prompt-trigger keywords derived from the actual bugs found (e.g. "v-html", "XSS", "console.log", "querySelector"). These are word-boundary matchable — no whitespace inside a token.
- ≤120 lines total.

SCOPE: $surf only. Do not look at files outside this dir.

Run \`ls $surf\` and read the most-relevant files, then output the fragment beginning with '---'.
EOF
)"

    local out_json
    set +e
    out_json="$(cd "$target" && claude --print --model "$model" \
                  --output-format json \
                  --permission-mode bypassPermissions \
                  --max-turns 15 \
                  "$prompt")"
    local rc=$?
    set -e
    if [ $rc -ne 0 ] || [ -z "$out_json" ]; then
      echo "  ⚠ rescan failed for $surf (rc=$rc)" >&2
      continue
    fi

    local body cost
    body="$(printf '%s' "$out_json" | jq -r '.result // empty')"
    cost="$(printf '%s' "$out_json" | jq -r '.total_cost_usd // 0')"
    total_cost="$(awk -v a="$total_cost" -v b="$cost" 'BEGIN{printf "%.4f", a+b}')"

    # Strip any preamble before the first '---'
    body="$(printf '%s\n' "$body" | awk '
      BEGIN { found = 0 }
      /^---[[:space:]]*$/ { found = 1 }
      found
    ')"
    # Drop duplicate leading '---' if present
    if printf '%s\n' "$body" | head -2 | awk '/^---[[:space:]]*$/' | wc -l | grep -q '^2$'; then
      body="$(printf '%s\n' "$body" | tail -n +2)"
    fi

    # Archive any previous bug-note for this surface (different date)
    local prior
    prior="$(find "$target/.richardbot-memory" -maxdepth 1 -type f -name "${slug}-bugs-*.md" \
              ! -name "${slug}-bugs-${today}.md" 2>/dev/null || true)"
    if [ -n "$prior" ]; then
      mkdir -p "$archive_dir"
      while IFS= read -r old; do
        [ -z "$old" ] && continue
        mv "$old" "$archive_dir/"
        echo "  ↳ archived $(basename "$old") → .archive/" >&2
      done <<< "$prior"
    fi

    printf '%s\n' "$body" > "$target/$out_name"
    echo "  ✓ wrote $out_name (\$$cost, $(wc -l < "$target/$out_name") lines)" >&2
    rescanned=$((rescanned + 1))
  done

  # ── --age-out: archive memory notes older than N days ────────────────────
  if [ -n "$age_out" ]; then
    mkdir -p "$archive_dir"
    local aged=0
    while IFS= read -r old; do
      [ -z "$old" ] && continue
      mv "$old" "$archive_dir/"
      echo "  ↳ aged-out $(basename "$old") → .archive/" >&2
      aged=$((aged + 1))
    done < <(find "$target/.richardbot-memory" -maxdepth 1 -type f -name '*.md' \
              ! -name 'README.md' ! -name '_recent.md' \
              -mtime "+${age_out}" 2>/dev/null)
    [ "$aged" -gt 0 ] && echo "→ aged out $aged memory note(s) older than ${age_out}d" >&2
  fi

  echo >&2
  echo "Rescanned $rescanned surface(s). Total cost: \$$total_cost" >&2

  # ── Auto-re-run copilot-mirror so .github/ catches up ────────────────────
  if [ "$run_mirror" = "1" ] && [ -f "$target/.github/copilot-instructions.md" ]; then
    echo "→ refreshing copilot mirror..." >&2
    do_copilot_mirror
  fi
}

# ── verify ──────────────────────────────────────────────────────────────────
# Compare current framework files against the .claude/INSTALLED manifest
# written at init/update time. Reports tampered / missing / extra files.
# ── import-overview ─────────────────────────────────────────────────────────
# Take an existing architecture-overview markdown (a "Shape A" monolith) and
# split it into per-H2 fragments under .claude/rules/architecture-<slug>.md,
# each with derived triggers, so its content loads lazily under the fragment
# model instead of always-on. The source md is consumed read-only — we don't
# move or delete it; the operator decides whether to keep the original.
do_import_overview() {
  local src=""
  shift 2 || true
  src="${1:-}"
  if [ -z "$src" ] || [ ! -f "$src" ]; then
    echo "⚠ Usage: richardbot-init import-overview [target-dir] <path-to-source.md>" >&2
    exit 2
  fi

  command -v python3 >/dev/null 2>&1 || { echo "⚠ python3 required" >&2; exit 2; }
  [ -d "$target/.claude/rules" ] || { echo "⚠ Run 'init' first." >&2; exit 2; }

  python3 - "$target" "$src" <<'PYEOF'
import os, re, sys

target, src_path = sys.argv[1], sys.argv[2]
rules_dir = os.path.join(target, ".claude/rules")

with open(src_path) as f:
    text = f.read()

# Strip any prose prefix before the first real H1 / H2.
# Walk line-by-line; skip past fenced code blocks so a `# comment` inside a
# bash fence doesn't get mistaken for an H1.
_lines_for_prefix = text.split("\n")
_in_fence = False
_start_idx = 0
for _i, _line in enumerate(_lines_for_prefix):
    if _line.startswith("```"):
        _in_fence = not _in_fence
        continue
    if _in_fence:
        continue
    if _line.lstrip().startswith("# ") or _line.lstrip().startswith("## "):
        _start_idx = _i
        break
text = "\n".join(_lines_for_prefix[_start_idx:])

# Topic synonym map — augment derived tokens with terms readers actually use
SYNONYMS = {
    "build": ["webpack", "bundle", "dist", "compile"],
    "pipeline": ["webpack", "bundle", "ci", "deploy"],
    "vue": ["vue", "data-vue-root", "composition", "options-api", "mount"],
    "architecture": ["pattern", "structure"],
    "pinia": ["store", "state", "useCartStore", "useProductStore"],
    "service": ["service", "api", ".service.js"],
    "styling": ["scss", "tailwind", "itcss", "css"],
    "shopify": ["liquid", "snippet", "section", "template", "theme"],
    "templating": ["liquid", "section", "snippet", "template", "layout"],
    "integration": ["algolia", "nosto", "onetrust", "yotpo", "klaviyo"],
    "third-party": ["algolia", "nosto", "onetrust", "integration", "vendor"],
    "analytics": ["gtm", "datalayer", "tracking", "adobe", "tag"],
    "tracking": ["gtm", "datalayer", "tracking", "analytics"],
    "market": ["locale", "i18n", "currency", "hreflang", "country"],
    "i18n": ["locale", "translation", "currency", "hreflang"],
    "subscription": ["recharge", "subscription", "swap", "billing"],
    "recharge": ["subscription", "swap", "billing", "portal"],
    "workflow": ["npm", "command", "lint", "build", "deploy"],
    "development": ["npm", "command", "lint", "build", "dev"],
    "deployment": ["ci", "circleci", "deploy", "production", "staging"],
    "naming": ["convention", "naming", "snippet", "filename"],
    "convention": ["naming", "convention", "filename"],
    "overview": ["overview", "stack", "platform"],
    "structure": ["structure", "directory", "layout"],
    "cart": ["cart", "sidecart", "cartline", "line item"],
    "product": ["product", "pdp", "variant", "gallery"],
    "wishlist": ["wishlist", "favorite"],
    "gwp": ["gwp", "gift", "free gift"],
    "search": ["search", "algolia", "predictive"],
    "blog": ["blog", "article"],
    "account": ["account", "login", "register", "customer"],
    "section": ["section", "snippet", "liquid"],
    "content": ["section", "hero", "banner", "rich-text"],
}

STOPWORDS = frozenset("the and for that with from this what are how when via per all any only one new our own its".split())

def slugify(title):
    s = re.sub(r'^\d+\.\s*', '', title)           # strip "N. " numeric prefix
    s = re.sub(r'[^a-zA-Z0-9\s-]', '', s)
    s = re.sub(r'\s+', '-', s.strip().lower())
    return s or "section"

def derive_triggers(title, body):
    title_words = re.findall(r'[A-Za-z][A-Za-z0-9-]{2,}', title.lower())
    title_words = [w for w in title_words if w not in STOPWORDS and len(w) >= 4]
    para_words = re.findall(r'[A-Za-z][A-Za-z0-9-]{3,}', body[:400].lower())
    para_words = [w for w in para_words if w not in STOPWORDS and len(w) >= 5]

    triggers = []
    seen = set()

    for w in title_words:
        if w not in seen:
            triggers.append(w); seen.add(w)
        for syn in SYNONYMS.get(w, []):
            sl = syn.lower()
            if sl not in seen:
                triggers.append(syn); seen.add(sl)
        if len(triggers) >= 6:
            break

    if len(triggers) < 4:
        for w in para_words:
            if w not in seen:
                triggers.append(w); seen.add(w)
                if len(triggers) >= 6:
                    break

    return triggers[:8] or ["architecture"]

# Split on H2 boundaries
lines = text.split("\n")
sections = []
current = {"title": None, "body": []}
for line in lines:
    if re.match(r'^##\s+\S', line):
        if current["title"] is not None or current["body"]:
            sections.append(current)
        current = {"title": line[3:].strip(), "body": []}
    else:
        current["body"].append(line)
if current["title"] is not None:
    sections.append(current)

written = 0
skipped = []
for sec in sections:
    title = sec["title"]
    if not title:
        continue
    body_text = "\n".join(sec["body"]).strip()
    if not body_text:
        skipped.append(title + " (empty)")
        continue

    slug = slugify(title)
    out_name = f"architecture-{slug}.md"
    out_path = os.path.join(rules_dir, out_name)

    # Description: first non-empty, non-table-row line of body
    desc = ""
    for line in body_text.split("\n"):
        line = line.strip()
        if line and not line.startswith("|") and not line.startswith("```") and not line.startswith("---"):
            desc = re.sub(r'\*\*([^*]+)\*\*', r'\1', line)  # strip bold
            desc = re.sub(r'\[([^]]+)\]\([^)]+\)', r'\1', desc)  # strip links
            if len(desc) > 200:
                desc = desc[:197] + "..."
            break
    if not desc:
        desc = f"{title} — architecture reference"

    triggers = derive_triggers(title, body_text)

    fm = ["---"]
    fm.append(f"description: {desc}")
    fm.append("alwaysApply: false")
    fm.append("triggers:")
    fm.append("  prompt:")
    for t in triggers:
        fm.append(f'    - "{t}"')
    fm.append("---")
    fm.append("")
    fm.append(f"# {title}")
    fm.append("")
    fm.append(body_text)
    fm.append("")

    with open(out_path, "w") as f:
        f.write("\n".join(fm))
    written += 1
    print(f"  ✓ wrote .claude/rules/{out_name} ({len(body_text.splitlines())} body lines, triggers: {', '.join(triggers)})")

print(f"\nWrote {written} fragment(s) under .claude/rules/architecture-*.md")
if skipped:
    print(f"Skipped (empty): {', '.join(skipped)}")
PYEOF
}

# ── plant ───────────────────────────────────────────────────────────────────
# Deliberate AI-or-operator memory write. Writes a markdown file under
# .richardbot-memory/<name>.md with the supplied frontmatter (type, triggers,
# description, date) and body, then optionally re-runs copilot-mirror so the
# new note reaches Copilot consumers.
#
# Designed to be called from role files: when dev / qa / scan finds something
# worth persisting that's not the work-of-the-moment (a tangential bug, a
# friction observation, a runbook waypoint), plant it instead of letting it
# evaporate when the conversation ends.
#
# Two body-input modes:
#   --body-stdin       read body from stdin
#   --body "text"      inline body argument
#
# Required:
#   <name>             slug (lowercase-kebab-case; .md auto-appended)
#   --description X    one-line summary (≤200 chars; used in frontmatter)
#
# Optional:
#   --type T           friction | reference | runbook | findings (default: friction)
#   --triggers "a,b,c" comma-separated prompt-trigger tokens (≥3 recommended)
#   --no-mirror        skip auto re-run of copilot-mirror
#   --force            overwrite if file already exists
do_plant() {
  local name=""
  local description=""
  local type="friction"
  local triggers_csv=""
  local body_text=""
  local body_stdin="0"
  local run_mirror="1"
  local force="0"

  shift 2 2>/dev/null || true
  name="${1:-}"
  [ -n "$name" ] && shift

  while [ $# -gt 0 ]; do
    case "$1" in
      --description) description="$2"; shift 2 ;;
      --type)        type="$2"; shift 2 ;;
      --triggers)    triggers_csv="$2"; shift 2 ;;
      --body)        body_text="$2"; shift 2 ;;
      --body-stdin)  body_stdin="1"; shift ;;
      --no-mirror)   run_mirror="0"; shift ;;
      --force)       force="1"; shift ;;
      *)             echo "⚠ unknown plant flag: $1" >&2; shift ;;
    esac
  done

  if [ -z "$name" ] || [ -z "$description" ]; then
    cat >&2 <<EOF
⚠ Usage: richardbot-init plant <name> --description "<line>" [opts]

Required:
  <name>                 kebab-case slug (e.g. cart-discount-edge-2026-05-15)
  --description "<line>" one-line summary used in frontmatter (≤200 chars)

Optional:
  --type T               friction | reference | runbook | findings (default: friction)
  --triggers "a,b,c"     comma-separated prompt-trigger tokens
  --body "<text>"        inline body text (mutually exclusive with --body-stdin)
  --body-stdin           read body markdown from stdin
  --no-mirror            skip the auto re-run of copilot-mirror
  --force                overwrite an existing file with the same name

Example:
  richardbot-init plant cart-discount-stacking-bug \\
    --type friction \\
    --description "Cart discount stacking applies twice on bundle items" \\
    --triggers "discount, stacking, bundle, cart" \\
    --body-stdin <<MD
  # Cart discount double-stacks on bundle items

  ## Repro
  ...
  MD
EOF
    exit 2
  fi

  [ -d "$target/.richardbot-memory" ] || mkdir -p "$target/.richardbot-memory"
  local fname
  fname="$(printf '%s' "$name" | sed 's/\.md$//')"
  local out_path="$target/.richardbot-memory/${fname}.md"

  if [ -e "$out_path" ] && [ "$force" != "1" ]; then
    echo "⚠ Already exists: $out_path  (pass --force to overwrite)" >&2
    exit 2
  fi

  if [ "$body_stdin" = "1" ]; then
    body_text="$(cat)"
  fi

  local today
  today="$(date +%Y-%m-%d)"

  # Build triggers block (YAML list under triggers.prompt)
  local triggers_block=""
  if [ -n "$triggers_csv" ]; then
    triggers_block="triggers:"$'\n'"  prompt:"
    local OLD_IFS="$IFS"
    IFS=","
    for tok in $triggers_csv; do
      tok="$(printf '%s' "$tok" | sed 's/^ *//;s/ *$//')"
      [ -z "$tok" ] && continue
      triggers_block="${triggers_block}"$'\n'"    - \"${tok}\""
    done
    IFS="$OLD_IFS"
  fi

  {
    echo "---"
    printf 'description: %s\n' "$description"
    printf 'date: %s\n' "$today"
    printf 'type: %s\n' "$type"
    if [ -n "$triggers_block" ]; then
      printf '%s\n' "$triggers_block"
    fi
    echo "---"
    echo
    if [ -n "$body_text" ]; then
      printf '%s\n' "$body_text"
    fi
  } > "$out_path"

  echo "✓ Planted $out_path ($(wc -l < "$out_path") lines)" >&2

  if [ "$run_mirror" = "1" ] && [ -f "$target/.github/copilot-instructions.md" ]; then
    echo "→ Refreshing copilot mirror..." >&2
    do_copilot_mirror
  fi
}

do_verify() {
  local manifest="$target/.claude/INSTALLED"
  if [ ! -f "$manifest" ]; then
    echo "⚠ No manifest at $manifest — run 'richardbot-init init' or 'update' first."
    exit 2
  fi
  echo "Verifying framework integrity against $manifest..."
  local fails=0
  while IFS= read -r line; do
    local expected_hash file
    expected_hash="$(awk '{print $1}' <<<"$line")"
    file="$(awk '{print $2}' <<<"$line")"
    if [ ! -f "$target/$file" ]; then
      echo "  ✗ MISSING: $file"
      fails=$((fails+1))
      continue
    fi
    local actual_hash
    actual_hash="$(sha256sum "$target/$file" | awk '{print $1}')"
    if [ "$actual_hash" != "$expected_hash" ]; then
      echo "  ✗ TAMPERED: $file"
      echo "       expected: $expected_hash"
      echo "       actual:   $actual_hash"
      fails=$((fails+1))
    else
      echo "  ✓ ok:       $file"
    fi
  done < "$manifest"

  if [ "$fails" -eq 0 ]; then
    echo "✓ All framework files match manifest."
  else
    echo "⚠ $fails file(s) differ. Run 'richardbot-init update' to restore."
    exit 2
  fi
}

# ── pack ───────────────────────────────────────────────────────────────────
# Install / list / remove opinionated rule fragment bundles from packs/<name>/.
# Args after "pack" are <sub> [<name>] [<target-dir>]; target defaults to pwd.
do_pack() {
  shift  # drop "pack" mode arg
  local sub="${1:-list}"
  shift || true

  # If the next arg looks like a path that exists, treat it as target; else it's the pack name.
  local name=""
  if [ -n "${1:-}" ]; then
    if [ -d "${1}/.claude" ] || [ -f "${1}/CLAUDE.md" ]; then
      target="$(cd "$1" && pwd)"
      shift
    elif [ -d "${1}" ] && [ "$sub" = "list" ]; then
      target="$(cd "$1" && pwd)"
      shift
    else
      name="$1"
      shift
    fi
  fi
  # If still got an arg, it's the target dir
  if [ -n "${1:-}" ]; then
    target="$(cd "$1" && pwd)"
    shift
  fi

  case "$sub" in
    list)
      local manifest="$target/.claude/PACKS"
      if [ ! -f "$manifest" ]; then
        echo "No packs installed (no $manifest)."
        echo
        echo "Available packs in $TEMPLATE_ROOT/packs/:"
        for d in "$TEMPLATE_ROOT/packs"/*/; do
          [ -d "$d" ] && echo "  $(basename "$d")"
        done
        return 0
      fi
      echo "Installed packs:"
      sed 's/^/  /' "$manifest"
      ;;
    add)
      [ -z "$name" ] && { echo "⚠ Usage: richardbot-init pack add <name> [target-dir]" >&2; exit 2; }
      local src="$TEMPLATE_ROOT/packs/$name"
      [ -d "$src" ] || { echo "⚠ Pack '$name' not found in $TEMPLATE_ROOT/packs/" >&2; exit 2; }
      [ -d "$target/.claude/rules" ] || { echo "⚠ Target has no .claude/rules/ — run 'init' first." >&2; exit 2; }

      local count=0
      for f in "$src"/*.md; do
        [ -f "$f" ] || continue
        local base
        base="$(basename "$f")"
        # Skip the pack's README — that's documentation, not a rule
        [ "$base" = "README.md" ] && continue
        cp "$f" "$target/.claude/rules/$base"
        count=$((count+1))
      done
      # Record in manifest
      touch "$target/.claude/PACKS"
      if ! grep -qxF "$name" "$target/.claude/PACKS" 2>/dev/null; then
        echo "$name" >> "$target/.claude/PACKS"
      fi
      echo "✓ Pack '$name' installed: $count rule fragment(s) copied to .claude/rules/"
      ;;
    remove)
      [ -z "$name" ] && { echo "⚠ Usage: richardbot-init pack remove <name> [target-dir]" >&2; exit 2; }
      local src="$TEMPLATE_ROOT/packs/$name"
      [ -d "$src" ] || { echo "⚠ Pack '$name' not found in template" >&2; exit 2; }

      local removed=0 preserved=0
      for f in "$src"/*.md; do
        [ -f "$f" ] || continue
        local base
        base="$(basename "$f")"
        [ "$base" = "README.md" ] && continue
        local dst="$target/.claude/rules/$base"
        if [ -f "$dst" ] && cmp -s "$f" "$dst"; then
          rm -f "$dst"
          removed=$((removed+1))
        elif [ -f "$dst" ]; then
          echo "  (preserved customized $base — remove manually if unwanted)"
          preserved=$((preserved+1))
        fi
      done
      # Strip from manifest
      if [ -f "$target/.claude/PACKS" ]; then
        grep -v "^$name$" "$target/.claude/PACKS" > "$target/.claude/PACKS.tmp" 2>/dev/null || true
        mv "$target/.claude/PACKS.tmp" "$target/.claude/PACKS"
        # Remove manifest entirely if now empty
        [ -s "$target/.claude/PACKS" ] || rm -f "$target/.claude/PACKS"
      fi
      echo "✓ Pack '$name' removed: $removed file(s) removed, $preserved preserved (customized)."
      ;;
    *)
      echo "⚠ Unknown pack sub-command: $sub" >&2
      echo "    Usage: richardbot-init pack <list|add|remove> [name]" >&2
      exit 2
      ;;
  esac
}

# ── copilot-mirror ──────────────────────────────────────────────────────────
# Generate GitHub Copilot equivalents of .claude/rules/ AND .richardbot-memory/.
#
# Mapping (rules):
#   - alwaysApply: true   → folded into .github/copilot-instructions.md
#   - globs: present      → .github/instructions/<name>.instructions.md with `applyTo: <globs>`
#   - only prompt triggers → folded into copilot-instructions.md with a note
#
# Mapping (memory — friction notes, scan findings, runbooks etc):
#   - Every .richardbot-memory/*.md (except README.md / _recent.md) is folded
#     into a "Known findings" section of copilot-instructions.md so Copilot can
#     ANSWER FROM MEMORY about already-discovered issues instead of re-grepping.
#   - If the memory body mentions paths under common surface dirs (src/, app/,
#     etc.), an additional .github/instructions/memory-<name>.instructions.md
#     is written with a derived applyTo glob so editing in that surface primes
#     the finding into Copilot context.
#
# This is a one-shot generator. Re-run after editing sources to refresh.
do_copilot_mirror() {
  [ -d "$target/.claude/rules" ] || { echo "⚠ Target has no .claude/rules/ — run 'init' first." >&2; exit 2; }

  command -v python3 >/dev/null 2>&1 || { echo "⚠ python3 required for YAML parsing." >&2; exit 2; }

  # The static discipline+memory preamble is the crown jewel: it must sit ABOVE
  # the generated region and survive every re-run. Resolve it from the bundled
  # template assets so an installed checkout works standalone.
  local preamble_src="$TEMPLATE_ROOT/assets/copilot-preamble.md"

  python3 - "$target" "$preamble_src" <<'PYEOF'
import os, sys, re

target = sys.argv[1]
preamble_src = sys.argv[2]

# Sentinel-managed region. Everything ABOVE this line is preserved verbatim on
# re-run (the static preamble + any hand edits); everything below is generated.
SENTINEL = "<!-- BEGIN richardbot-mirror — generated; everything below is overwritten on re-run -->"
rules_dir = os.path.join(target, ".claude/rules")
mem_dir = os.path.join(target, ".richardbot-memory")
gh_dir = os.path.join(target, ".github")
inst_dir = os.path.join(gh_dir, "instructions")
os.makedirs(inst_dir, exist_ok=True)

main_path = os.path.join(gh_dir, "copilot-instructions.md")

def split_frontmatter(text):
    """Return (frontmatter_dict, body_str). Naive YAML — handles our simple shape."""
    if not text.startswith("---"):
        return ({}, text)
    end = text.find("\n---", 3)
    if end == -1:
        return ({}, text)
    fm_text = text[3:end].strip()
    body = text[end+4:].lstrip("\n")
    fm = {}
    cur_key = None
    cur_sub = None
    for raw in fm_text.split("\n"):
        line = raw.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        # Top-level scalar: "key: value"
        m = re.match(r'^([A-Za-z_][A-Za-z0-9_]*):\s*(.+)$', line)
        if m and not line.startswith(" ") and not line.startswith("\t"):
            k, v = m.group(1), m.group(2).strip()
            # Inline list
            il = re.match(r'^\[(.*)\]$', v)
            if il:
                items = [x.strip().strip('"').strip("'") for x in il.group(1).split(",") if x.strip()]
                fm[k] = items
            else:
                fm[k] = v.strip('"').strip("'")
            cur_key = None
            cur_sub = None
            continue
        # Top-level block key: "key:"
        m = re.match(r'^([A-Za-z_][A-Za-z0-9_]*):\s*$', line)
        if m:
            cur_key = m.group(1)
            cur_sub = None
            fm.setdefault(cur_key, {})
            continue
        # Sub-block: "  key:"
        m = re.match(r'^  ([A-Za-z_][A-Za-z0-9_]*):\s*$', line)
        if m and cur_key:
            cur_sub = m.group(1)
            if isinstance(fm[cur_key], dict):
                fm[cur_key][cur_sub] = []
            continue
        # List item: "    - value" or "  - value"
        m = re.match(r'^(\s+)-\s+(.+)$', line)
        if m:
            v = m.group(2).strip().strip('"').strip("'")
            if cur_sub and cur_key and isinstance(fm.get(cur_key), dict):
                fm[cur_key][cur_sub].append(v)
            elif cur_key and isinstance(fm.get(cur_key), dict) and not cur_sub:
                # block was actually a list, not a sub-dict — convert
                if isinstance(fm[cur_key], dict) and not fm[cur_key]:
                    fm[cur_key] = []
                if isinstance(fm[cur_key], list):
                    fm[cur_key].append(v)
            elif cur_key and isinstance(fm.get(cur_key), list):
                fm[cur_key].append(v)
    return (fm, body)

# Build the GENERATED region (folded always-load rules + memory) and the
# per-glob instructions files. This region lives BELOW the sentinel; the
# preamble above it is preserved across runs.
main_chunks = [
    "<!-- Generated from `.claude/rules/*.md` and `.richardbot-memory/*.md` by",
    "`richardbot-init copilot-mirror`. Edit the SOURCES, not this region — it is",
    "overwritten on every re-run. Hand edits go ABOVE the sentinel line. -->\n",
]

count_always = 0
count_glob = 0
count_prompt_only = 0
skipped = []

for fname in sorted(os.listdir(rules_dir)):
    if not fname.endswith(".md"):
        continue
    if fname in ("README.md", "example-surface.md"):
        skipped.append(fname)
        continue
    path = os.path.join(rules_dir, fname)
    with open(path) as f:
        text = f.read()
    fm, body = split_frontmatter(text)

    always = (str(fm.get("alwaysApply", "")).lower() == "true")
    globs = fm.get("globs") if isinstance(fm.get("globs"), list) else []
    prompt_trigs = []
    if isinstance(fm.get("triggers"), dict):
        prompt_trigs = fm["triggers"].get("prompt", []) or []

    if always:
        main_chunks.append(f"\n## From `.claude/rules/{fname}`\n")
        main_chunks.append(body.rstrip())
        count_always += 1
    elif globs:
        out_name = fname.replace(".md", ".instructions.md")
        out_path = os.path.join(inst_dir, out_name)
        apply_to = ", ".join(f'"{g}"' for g in globs)
        # Copilot wants applyTo as a single string with comma-separation in most current schemas
        single = ",".join(globs)
        with open(out_path, "w") as f:
            f.write("---\n")
            f.write(f'applyTo: "{single}"\n')
            f.write("---\n\n")
            f.write(body.rstrip())
            f.write("\n")
        count_glob += 1
    elif prompt_trigs:
        # Copilot has no prompt-keyword trigger. Fold into always-loaded with a note.
        main_chunks.append(f"\n## From `.claude/rules/{fname}` (folded — prompt-keyword triggers don't translate to Copilot)\n")
        main_chunks.append(f"Original triggers: {', '.join(repr(t) for t in prompt_trigs)}\n")
        main_chunks.append(body.rstrip())
        count_prompt_only += 1
    else:
        skipped.append(fname + " (no triggers / no alwaysApply)")

# ── memory pass: fold .richardbot-memory/*.md into copilot-instructions.md ──
# Memory notes are "things already discovered in this codebase" — file:line
# findings from prior scans, friction observations, runbooks. Copilot should
# answer questions about these from memory, not by re-grepping.
count_memory = 0
glob_memory = 0

# Common source-dir prefixes we'll auto-derive applyTo globs for. Conservative
# — we only emit a per-glob instructions file when the memory body clearly
# refers to one of these dirs. Otherwise the note is always-load only.
COMMON_PREFIXES = (
    "src/vue/components/cart/", "src/vue/components/product/",
    "src/vue/components/checkout/", "src/vue/components/collection/",
    "src/vue/", "src/", "app/components/", "app/utils/", "app/", "lib/",
    "components/", "pages/", "scripts/",
)

memory_intro_emitted = False

if os.path.isdir(mem_dir):
    for fname in sorted(os.listdir(mem_dir)):
        if not fname.endswith(".md"):
            continue
        if fname in ("README.md", "_recent.md"):
            continue
        path = os.path.join(mem_dir, fname)
        with open(path) as f:
            text = f.read()
        fm, body = split_frontmatter(text)

        if not memory_intro_emitted:
            main_chunks.append("\n---\n\n## Known findings (from .richardbot-memory/)\n")
            main_chunks.append(
                "These are concrete file:line findings already surfaced in earlier"
                " scans of this codebase. When asked about them in chat, answer"
                " FROM these notes — do not re-grep unless the user asks for"
                " verification.\n"
            )
            memory_intro_emitted = True

        main_chunks.append(f"\n### From `.richardbot-memory/{fname}`\n")
        main_chunks.append(body.rstrip())
        count_memory += 1

        # Derive applyTo glob from the most-mentioned common prefix in the body.
        prefix_hits = []
        for p in COMMON_PREFIXES:
            n = body.count(p)
            if n > 0:
                prefix_hits.append((n, p))
        if prefix_hits:
            prefix_hits.sort(reverse=True)
            best = prefix_hits[0][1]
            glob = best.rstrip("/") + "/**"
            slug = fname.replace(".md", "")
            out_path = os.path.join(inst_dir, f"memory-{slug}.instructions.md")
            with open(out_path, "w") as f:
                f.write("---\n")
                f.write(f'applyTo: "{glob}"\n')
                f.write("---\n\n")
                f.write(f"# Known findings under `{best}`\n\n")
                f.write("These were surfaced by an earlier scan. Prefer fixing")
                f.write(" them when editing files in this surface.\n\n")
                f.write(body.rstrip())
                f.write("\n")
            glob_memory += 1

# ── Resolve the preserved preamble (everything above the sentinel) ──────────
# If the file already exists with a sentinel, keep everything above it VERBATIM
# (the static preamble plus any hand edits). Otherwise seed from the shipped
# asset. This is the clobber fix: a re-run never wipes hand-added content above
# the sentinel.
preamble_preserved = None
if os.path.exists(main_path):
    with open(main_path) as f:
        existing = f.read()
    idx = existing.find(SENTINEL)
    if idx != -1:
        preamble_preserved = existing[:idx].rstrip("\n")

if preamble_preserved is None:
    if os.path.exists(preamble_src):
        with open(preamble_src) as f:
            preamble_preserved = f.read().rstrip("\n")
    else:
        # Asset missing (assets/ not bundled): fall back to a minimal preamble so
        # mirror still produces a usable file rather than crashing.
        print("⚠ assets/copilot-preamble.md not found — emitting minimal preamble.")
        preamble_preserved = (
            "# Copilot instructions\n\n"
            "> Read this file fully before your first action.\n"
        )

# Write main: preserved preamble + sentinel + generated region.
with open(main_path, "w") as f:
    f.write(preamble_preserved)
    f.write("\n\n")
    f.write(SENTINEL)
    f.write("\n\n")
    f.write("\n".join(main_chunks))
    f.write("\n")

print(f"✓ Wrote .github/copilot-instructions.md ({count_always} alwaysApply + {count_prompt_only} prompt-only folded + {count_memory} memory notes)")
print(f"✓ Wrote {count_glob + glob_memory} files into .github/instructions/ ({count_glob} from rules + {glob_memory} from memory)")
if skipped:
    print(f"  skipped: {', '.join(skipped)}")
PYEOF
}

case "$mode" in
  init)            do_init "$@" ;;
  survey)          do_survey ;;
  seed)            do_seed "$@" ;;
  rescan)          do_rescan "$@" ;;
  plant)           do_plant "$@" ;;
  pack)            do_pack "$@" ;;
  mcp)             do_mcp "$@" ;;
  copilot-mirror)  do_copilot_mirror ;;
  import-overview) do_import_overview "$@" ;;
  verify)          do_verify ;;
  update)          do_update ;;
  uninstall)       do_uninstall ;;
  nuke)            do_nuke "$@" ;;
  *)               usage ;;
esac
